# 官方镜像版本；升级前先校验配置兼容性。
MIHOMO_VERSION=v1.19.33

# 宿主机的 IPv4 绑定地址。0.0.0.0 允许本机和局域网访问。
PROXY_BIND_IP=0.0.0.0

# 仅修改宿主机端口；config/config.yaml 中仍使用容器端口 7890 和 7891。
# 当前旧 Clash 正在运行，并行验证时将下面两项改为 17890 / 17891。
MIXED_PORT=7890
SOCKS_PORT=7891

# 网页管理面板端口，以及面板连接的 Mihomo 管理 API 端口。
DASHBOARD_PORT=8080
CONTROLLER_PORT=19090

TZ=Asia/Shanghai
