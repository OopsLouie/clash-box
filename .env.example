# Official release tag. Upgrade deliberately after checking configuration compatibility.
MIHOMO_VERSION=v1.19.33

# IPv4 address on the Docker host. 0.0.0.0 allows local and LAN access.
PROXY_BIND_IP=0.0.0.0

# Host ports only; config/config.yaml must keep container ports 7890 and 7891.
# Use 17890 / 17891 while the existing host Clash is still running.
MIXED_PORT=7890
SOCKS_PORT=7891

TZ=Asia/Shanghai
